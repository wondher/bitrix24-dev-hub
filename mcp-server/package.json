{
  "name": "@wondher/b24-dev-hub",
  "version": "1.0.0",
  "description": "MCP server for the Bitrix24 Developer Hub — intelligent search across SDKs, UI components, REST API docs, examples, and templates. Runs over stdio; clones its content cache on first use so `npx @wondher/b24-dev-hub` works anywhere.",
  "type": "module",
  "main": "index.js",
  "bin": {
    "b24-dev-hub": "index.js"
  },
  "files": [
    "index.js",
    "cli.js",
    "lib/"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wondher/bitrix24-dev-hub.git",
    "directory": "mcp-server"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "test": "node --test"
  },
  "keywords": [
    "bitrix24",
    "mcp",
    "model-context-protocol",
    "sdk",
    "rest-api",
    "developer-tools"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "glob": "^11.0.0",
    "zod": "^3.24.0"
  }
}
